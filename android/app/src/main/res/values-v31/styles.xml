<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="LaunchTheme"
        parent="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Same background as Flutter splash -->
        <item name="android:windowSplashScreenBackground">
            #01030D
        </item>

        <!-- Static first frame of NeuroLens logo -->
        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/neurolens_splash_logo
        </item>

        <!-- Prevent Android from adding a different icon background -->
        <item name="android:windowSplashScreenIconBackgroundColor">
            #01030D
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:statusBarColor">
            #01030D
        </item>

        <item name="android:navigationBarColor">
            #01030D
        </item>

        <item name="android:windowActionModeOverlay">
            true
        </item>

    </style>

    <style
        name="NormalTheme"
        parent="@android:style/Theme.Material.Light.NoActionBar">

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:windowBackground">
            #01030D
        </item>

        <item name="android:statusBarColor">
            #01030D
        </item>

        <item name="android:navigationBarColor">
            #01030D
        </item>

    </style>

</resources>